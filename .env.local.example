# Copy this file to .env.local and populate keys before using the AI assistant
# OpenAI (fallback)
OPENAI_API_KEY=your_openai_api_key_here

# Groq (preferred for this project if you already have one)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# If using an alternate AI provider, set the corresponding environment variables
# e.g., ANTHROPIC_API_KEY=your_key
